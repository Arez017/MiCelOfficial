# Copia este archivo como .env.docker o agrega estas variables a tu .env
# cuando uses Docker

APP_NAME=MiCel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=micel_db
DB_USERNAME=micel
DB_PASSWORD=secret

# Opcional
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
